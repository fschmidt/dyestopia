{
  "name": "dyestopia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run wiki:check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "wiki": "tsx scripts/wiki.ts",
    "wiki:check": "tsx scripts/wiki.ts --check",
    "board": "board serve",
    "board:host": "board serve --host",
    "test": "playwright test",
    "test:engine": "playwright test --project=engine",
    "test:browser": "playwright test --project=1x --project=2x --project=iphone-15-pro-max",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "shots": "node scripts/screenshot.mjs",
    "shots:matrix": "node scripts/visual-matrix.mjs",
    "playout": "tsx scripts/playout.ts"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "marked": "^18.0.7",
    "planning-board": "git+https://github.com/fschmidt/planning-board.git",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
